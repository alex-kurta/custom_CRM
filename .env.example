# Fishbowl ↔ EspoCRM — copy to .env and fill (NEVER commit .env)
FISHBOWL_DB_HOST=
FISHBOWL_DB_PORT=3306
FISHBOWL_DB_NAME=
FISHBOWL_DB_USER=
FISHBOWL_DB_PASSWORD=
FISHBOWL_DB_SSL=false

ESPOCRM_API_URL=https://crm.example.com/api/v1
ESPOCRM_API_KEY=
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=

SYNC_INTERVAL_MINUTES=30
SYNC_BATCH_SIZE=500

# Optional: used once this directory becomes a git repo.
# SSH remotes need only GIT_REMOTE_URL.
GIT_REMOTE_URL=
