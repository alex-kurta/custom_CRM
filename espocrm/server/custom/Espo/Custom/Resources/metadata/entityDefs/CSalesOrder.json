{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "fishbowlId": {
            "type": "varchar",
            "isCustom": true
        },
        "fishbowlNum": {
            "type": "varchar",
            "isCustom": true
        },
        "customerId": {
            "type": "varchar",
            "isCustom": true
        },
        "amount": {
            "type": "currency",
            "isCustom": true
        },
        "status": {
            "type": "enum",
            "options": [
                "In Progress",
                "Issued",
                "Fulfilled",
                "Cancelled",
                "Estimate",
                "Closed Short",
                "Voided",
                "Expired",
                "Historical"
            ],
            "maxLength": 100,
            "isCustom": true
        },
        "orderDate": {
            "notNull": false,
            "type": "datetime",
            "isCustom": true
        },
        "account": {
            "type": "link"
        },
        "itemSummary": {
            "type": "text",
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "account": {
            "type": "belongsTo",
            "foreign": "cSalesOrders",
            "entity": "Account",
            "audited": false,
            "isCustom": true
        },
        "salesOrderItems": {
            "type": "hasMany",
            "foreign": "salesOrder",
            "entity": "CSalesOrderItem",
            "audited": false,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "fishbowlNum",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}